# Express Backend Base URL (required for auth, equipment APIs, bookings, and Stripe verification)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Canonical public URL of the Next.js frontend (used for Open Graph metadata and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Client-side ImgBB key used only for direct customer profile avatar uploads on registration
# Leave blank to paste an HTTPS avatar URL instead; owner equipment uploads proxy via /api/uploads/equipment-image
NEXT_PUBLIC_IMGBB_API_KEY=

# Optional: Stripe test publishable key placeholder if Stripe.js client features are added later
# Note: Never place STRIPE_SECRET_KEY, BETTER_AUTH_SECRET, GOOGLE_CLIENT_SECRET, or database URIs in client env files
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
